# VSE API — Environment template
# Copy to .env and fill in values.
# NIGDY nie commituj wypelnionej wersji!

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIza...
DEFAULT_LLM_PROVIDER=claude

# Logging
LOG_LEVEL=INFO

# Optional: YouTube Data API (for view counts)
# YT_API_KEY=AIza...

# Optional: Google Search Console
# GSC_CLIENT_ID=...
# GSC_CLIENT_SECRET=...
# GSC_REFRESH_TOKEN=...

# Optional: YouTube OAuth (for updating YT titles/descriptions)
# YT_CLIENT_ID=...
# YT_CLIENT_SECRET=...
# YT_REFRESH_TOKEN=...
