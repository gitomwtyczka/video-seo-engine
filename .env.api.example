# VSE API — Environment template
# Copy to .env and fill in values.
# NIGDY nie commituj wypelnionej wersji!

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIza...
DEFAULT_LLM_PROVIDER=claude

# Logging
LOG_LEVEL=INFO

# Lokalny runner — cookies YouTube dla yt-dlp (eksport z przeglądarki)
# YTDLP_COOKIES_FILE=C:/Users/tomas2/cookies/youtube_cookies.txt
YTDLP_COOKIES_FILE=

# Optional: YouTube Data API (for view counts)
# YT_API_KEY=AIza...

# Optional: Google Search Console
# GSC_CLIENT_ID=...
# GSC_CLIENT_SECRET=...
# GSC_REFRESH_TOKEN=...

# Optional: YouTube OAuth (for updating YT titles/descriptions)
# YT_CLIENT_ID=...
# YT_CLIENT_SECRET=...
# YT_REFRESH_TOKEN=...

USE_PRESSAI_ARTICLE_ENGINE=true
PRESSAI_API_URL=https://pressai.impresjapr.pl
PRESSAI_EXTERNAL_TOKEN=your_token_here

WP_URL=https://twojaportal.pl
WP_USER=wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
