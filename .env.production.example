# .env.production.example — VPS production secrets template
# Skopiuj jako .env.production i uzupełnij wartości
# NIGDY nie commituj .env.production do repo!

# ---- Gemini AI ----
GEMINI_API_KEY=tu_wstaw_klucz

# ---- WordPress — Prawy.pl ----
WP_BASE_URL=https://prawy.pl
WP_USER=tu_wstaw_uzytkownika
WP_APP_PASSWORD=tu_wstaw_application_password

# ---- YouTube Data API ----
YT_API_KEY=tu_wstaw_klucz

# ---- YouTube OAuth (dla opisu z rozdziałami) ----
YT_CLIENT_ID=tu_wstaw
YT_CLIENT_SECRET=tu_wstaw
YT_REFRESH_TOKEN=tu_wstaw

# ---- Channel ----
CHANNEL_ID=UCtu_wstaw_channel_id

# ---- Pipeline config ----
PORTAL=prawy
MONITOR_INTERVAL=1800
PUBLISH_DELAY_MIN=5
PUBLISH_DELAY_MAX=37

# ---- Paths (w kontenerze) ----
SUBS_DIR=data/prawy/subs
SEO_DIR=data/prawy/seo_results
