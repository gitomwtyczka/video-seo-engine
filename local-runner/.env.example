# VSE Local Transcript Runner — konfiguracja
# Skopiuj ten plik do .env i uzupelnij wartosciami

# WYMAGANE: Token autoryzacji dla Local Runnera
# Generowanie: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ten sam token musi byc w .env na VPS jako LOCAL_RUNNER_TOKEN
LOCAL_RUNNER_TOKEN=REPLACE_WITH_GENERATED_TOKEN

# URL API VSE (domyslnie: produkcja)
VSE_API_BASE=https://vse.impresjapr.pl

# Interwal pollowania w sekundach (domyslnie: 10)
# POLL_INTERVAL=10

# Poziom logow: DEBUG, INFO, WARNING, ERROR (domyslnie: INFO)
# LOG_LEVEL=INFO

# Katalog logów (domyslnie: C:\ProgramData\VSELocalRunner)
# LOG_DIR=C:\ProgramData\VSELocalRunner
