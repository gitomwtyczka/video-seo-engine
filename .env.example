# ============================================================
# PressAI Video SEO Engine -- Environment Variables
# ============================================================

# --- WYMAGANE ---

# Gemini API key (generator.py -- Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# WordPress credentials (Application Password -- nie haslo konta)
WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
WP_BASE_URL=https://prawy.pl

# Portal ID -- wybierz: prawy | kurier365 | biznesciti
PORTAL=prawy

# --- WYMAGANE dla vse watch (Faza 2 - Channel Monitor) ---

# YouTube Data API v3 -- wymagane do wykrywania nowych filmow (get_latest_videos)
YT_API_KEY=your_youtube_data_api_v3_key_here

# ID kanaalu YouTube do monitorowania
# Prawy TV: UCxxxxxxxxxxxxxxxxxxxxxxxxx (znajdz w URL kanaalu YT)
CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxx

# Co ile sekund sprawdzac kanaall YT (default: 3600 = 1h)
MONITOR_INTERVAL=3600

# --- OPCJONALNE ---

# WordPress category ID dla postow wideo (default: 2472 = Prawy TV)
# WP_CATEGORY_ID=2472

# Sciezki do plikow (nadpisuja domyslne)
# SUBS_DIR=/path/to/vtt/files
# SEO_DIR=/path/to/seo_results
# MATCHES_FILE=prawy_tv_matches.json

# YouTube Admin OAuth2 -- tylko jesli jestes wlascicielem kanalu
# Uzywane przez core/yt_admin.py do aktualizacji opisow YT
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=

# Google Search Console API
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
