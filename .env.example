# Required
GEMINI_API_KEY=your_gemini_api_key_here
WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
WP_BASE_URL=https://your-portal.pl

# WordPress category ID for video posts (default: 2472 = Prawy TV)
# WP_CATEGORY_ID=2472

# Paths (optional — override defaults)
# SUBS_DIR=/path/to/vtt/files
# MATCHES_OUTPUT=prawy_tv_matches.json

# Optional: YouTube Admin (OAuth2 — only if you own the channel)
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=

# Optional: Google Search Console API
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
