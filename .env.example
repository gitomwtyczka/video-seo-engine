# ============================================================
# PressAI Video SEO Engine — Environment Variables
# ============================================================

# --- WYMAGANE ---

# Gemini API key (generator.py — Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# WordPress credentials (Application Password — nie hasło konta)
WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_application_password
WP_BASE_URL=https://prawy.pl

# Portal ID — wybierz: prawy | kurier365 | biznesciti
PORTAL=prawy

# --- OPCJONALNE ---

# YouTube Data API v3 — potrzebne do pobierania viewCount (interactionStatistic)
# Bez klucza: view count pomijany w schemacie
# YT_API_KEY=

# WordPress category ID dla postów wideo (default: 2472 = Prawy TV)
# WP_CATEGORY_ID=2472

# Ścieżki do plików (nadpisują domyślne)
# SUBS_DIR=/path/to/vtt/files
# SEO_DIR=/path/to/seo_results
# MATCHES_FILE=prawy_tv_matches.json

# YouTube Admin OAuth2 — tylko jeśli jesteś właścicielem kanału
# Używane przez core/yt_admin.py do aktualizacji opisów YT
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=

# Google Search Console API
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
